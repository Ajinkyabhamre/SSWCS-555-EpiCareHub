# =============================================================================
# EpiCareHub - Unified Environment Configuration (SAFE TEMPLATE)
# =============================================================================
# ⚠️ DO NOT COMMIT .env
# Copy to .env and fill values LOCALLY ONLY
# =============================================================================

# =============================================================================
# FRONTEND (Vite) — BUILD TIME
# =============================================================================
VITE_API_BASE_URL=
VITE_PYTHON_API_URL=
VITE_EPICARE_DEV_MODE=
VITE_ENABLE_WEBGL_BRAIN=

# =============================================================================
# BACKEND (Node / Express)
# =============================================================================

# --- MongoDB (Atlas) ---
MONGODB_URI=
MONGODB_DB_NAME=

# --- Security ---
SESSION_SECRET=
ADMIN_REGISTRATION_SECRET=
EPICARE_INTERNAL_API_KEY=

# --- Service URLs ---
PYTHON_API_URL=
NODE_API_URL=

# --- Server ---
PORT=
NODE_ENV=
EPICARE_DEV_MODE=
CORS_ORIGIN=

# =============================================================================
# PYTHON API (FastAPI / MNE)
# =============================================================================

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FastAPI ---
HOST=0.0.0.0
LOG_LEVEL=WARNING