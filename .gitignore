.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
*.sublime-*
Thumbs.db
ehthumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln

