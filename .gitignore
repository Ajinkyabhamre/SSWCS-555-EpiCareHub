.env
.env.*
*.env.local
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*.der
*.csr
id_rsa
id_dsa
*.pub

# ============================================
# NODE.JS (Backend + Frontend)
# ============================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.pnp.*

# Build outputs
apps/frontend/dist/
apps/frontend/build/
apps/backend/dist/
apps/backend/build/
dist/
dist-ssr/
build/
*.tsbuildinfo
*.local

# Testing
coverage/
*.lcov
.nyc_output/

# IDE & OS
