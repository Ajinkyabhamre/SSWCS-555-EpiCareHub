# ============================================
# ML & DATA FILES (BLOAT PREVENTION)
# ============================================
# Model weights
*.pkl
*.pth
*.h5
*.hdf5
*.ckpt
*.safetensors
*.weights
checkpoints/
apps/brain-api/model/**/*.pkl
apps/brain-api/model/**/*.pth
apps/brain-api/model/**/*.h5

# Datasets
datasets/
!datasets/README.md
*.fif
*.mat
*.edf
*.bdf
*.nii
*.nii.gz
*.set
apps/brain-api/data/*.fif
apps/brain-api/data/*.h5
apps/brain-api/data/**/*.fif
apps/brain-api/data/**/*.h5
!apps/brain-api/data/eeg_maptable.mat

# Large brain models (hosted on CDN)
apps/frontend/public/models/*.obj
apps/frontend/public/models/*.gltf
apps/frontend/public/obj/*.obj
apps/frontend/public/obj/*.gltf
apps/frontend/public/obj/*.bin

# Runtime artifacts
apps/brain-api/uploads/
apps/brain-api/figures/
apps/brain-api/result/
apps/brain-api/output.json
apps/brain-api/overlay.json
apps/brain-api/test.png
apps/backend/uploads/
apps/backend/sessions/
uploads/
figures/
result/
**/output.json
**/overlay.json

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# NOTE: Keep .dockerignore files per-service
# (they control Docker build context, not git tracking)

# ============================================
# LOGS
# ============================================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt
scripts/*.log
local_settings.py

# ============================================
# BACKEND SPECIFIC
# ============================================
# PM2 process manager
pm2.config.js
ecosystem.config.js
.pm2/

# ============================================
# FRONTEND SPECIFIC
# ============================================
# Static analysis
.eslintcache
.parcel-cache

# Storybook
storybook-static/

# Next.js (if ever migrated from Vite)
.next/
out/

# ============================================
