# Environment variables (never commit real secrets)
# Allow: *.env.example files only
.env
.env.*
!.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example
Backend/.env
Backend/.env.*
!Backend/.env.example
Localization-Algorithm/.env
Localization-Algorithm/.env.*
!Localization-Algorithm/.env.example

# Dependencies
**/node_modules/

# Build outputs
Frontend/dist/
Frontend/build/
Backend/dist/
Backend/build/
dist/
build/
*.tsbuildinfo

# Testing
coverage/
*.lcov
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

