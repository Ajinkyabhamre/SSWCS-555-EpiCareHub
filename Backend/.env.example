# EpiCareHub Backend Environment Configuration
# Copy this file to .env and update with your actual values

# MongoDB Connection URI (REQUIRED - ATLAS ONLY)
# EpiCareHub connects ONLY to MongoDB Atlas (NO localhost fallback)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=YourAppName
# Replace 'username', 'password', and 'cluster.mongodb.net' with your Atlas credentials
# The application will FAIL FAST if this is not set or is invalid
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=ClusterDB

# MongoDB Database Name (REQUIRED - ATLAS ONLY)
# The name of your MongoDB Atlas database (case-sensitive)
# Default: epicarehubData (recommended)
# The application will FAIL FAST if this is not set
MONGODB_DB_NAME=epicarehubData

# Session Secret (used for session encryption)
# Generate a random string for production
SESSION_SECRET=your_session_secret_change_in_production

# Python ML Service URL
# The URL where the Localization-Algorithm FastAPI service is running
PYTHON_API_URL=http://localhost:8000

# Node Backend URL (for Python service callbacks)
# The public/own base URL of this Node.js backend
NODE_API_URL=http://localhost:3000

# Internal API Key (for Python → Node callbacks)
# Set this to a secure random string in production
# If not set, the /patients/upload endpoint will not require authentication (dev-friendly)
EPICARE_INTERNAL_API_KEY=your_secure_api_key_change_in_production

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development, staging, production)
NODE_ENV=development

# Dev Mode (enables /dev/* endpoints for testing)
# Set to "true" to enable dev/test endpoints:
#   - POST /dev/seed - Create demo patient and study data
#   - DELETE /dev/clean - Remove all demo data
# WARNING: Never enable in production!
EPICARE_DEV_MODE=false

# Admin Registration Secret
# Secret key required to register administrator accounts
# Keep this safe and DO NOT commit the real value to git
# If not set, admin registration will always fail (secure by default)
ADMIN_REGISTRATION_SECRET=your-admin-secret-here

# CORS Settings (optional, defaults to *)
# CORS_ORIGIN=http://localhost:5173
