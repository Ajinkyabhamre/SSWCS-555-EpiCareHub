# EpiCareHub Frontend Environment Configuration
# Vite requires VITE_ prefix for environment variables exposed to the client
# Copy this file to .env.local for development or .env.production for production

# Backend API Base URL
# Used for all REST API calls to the Express backend
VITE_API_BASE_URL=http://localhost:3000

# Python ML Service Base URL
# Used for brain visualization and EEG processing requests
VITE_PYTHON_API_URL=http://localhost:8000

# Dev Mode (enables dev endpoints for testing without real EEG files)
# Set to "true" to use /visualize_brain_dev instead of /visualize_brain
# This bypasses real EEG processing and generates placeholder data
# WARNING: Never enable in production!
VITE_EPICARE_DEV_MODE=false
