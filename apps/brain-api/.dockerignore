# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment files (use docker-compose env instead)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md
docs/

# Docker files (not needed in build context)
Dockerfile
.dockerignore
docker-compose.yml

# Logs
*.log
logs/

# Temporary files and uploads (runtime generated, not needed for build)
uploads/
temp/
tmp/
*.tmp
*.temp

# Large datasets (not needed in Docker build, mount as volume or download at runtime)
datasets/*.h5
datasets/*.fif
datasets/*.mat
datasets/*.nii
datasets/*.nii.gz
data/*.h5
data/*.fif
data/*.mat

# Model weights (download at runtime or mount as volume)
model/**/*.pkl
model/**/*.pth
model/**/*.h5
model/**/*.weights
*.ckpt
checkpoints/

# Jupyter notebooks (not needed in production)
*.ipynb
.ipynb_checkpoints/

# MNE data cache (will be regenerated)
~/mne_data/
